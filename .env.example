# ===========================================
# RAG Medan v3 - Environment Configuration
# ===========================================
# Copy file ini ke .env dan sesuaikan nilainya

# -------------------------------------------
# API Configuration
# -------------------------------------------
API_HOST=0.0.0.0

# -------------------------------------------
# Service Ports
# -------------------------------------------
ORCHESTRATOR_PORT=5000
TEXT_SERVICE_PORT=5010
DOCUMENT_SERVICE_PORT=5011
WEB_SERVICE_PORT=5012
USULAN_SERVICE_PORT=5013

# -------------------------------------------
# Service URLs (untuk orchestrator)
# -------------------------------------------
TEXT_SERVICE_URL=http://localhost:5010
DOCUMENT_SERVICE_URL=http://localhost:5011
WEB_SERVICE_URL=http://localhost:5012
USULAN_SERVICE_URL=http://localhost:5013

# -------------------------------------------
# Qdrant Configuration
# -------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# -------------------------------------------
# Collection Names
# -------------------------------------------
COLLECTION_TEXT=knowledge_bank
COLLECTION_DOCUMENT=document_bank
COLLECTION_WEB=web_scraping_bank
COLLECTION_WEB_STATE=web_scraping_state
COLLECTION_USULAN=usulan_bank

# -------------------------------------------
# Embedding Models
# -------------------------------------------
# Model untuk text, usulan, web (384 dimensions)
EMB_MODEL_PATH=D:/models/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Model untuk document (1024 dimensions)
EMB_LARGE_PATH=D:/models/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION_LARGE=1024

# -------------------------------------------
# LLM API (Gemini)
# -------------------------------------------
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SEC=60
# LLM_PROVIDER: "gemini" atau "router"
LLM_PROVIDER=gemini
# RELEVANCE_MODE: "single" (cek berurutan) atau "batch" (sekali request AI)
RELEVANCE_MODE=single

# -------------------------------------------
# AI Extraction Configuration
# -------------------------------------------
# Toggle untuk menampilkan sitasi/sumber pada jawaban akhir RAG
ENABLE_CITATION=true

# -------------------------------------------
# MySQL Database
# -------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=rag_medan
DB_USERNAME=root
DB_PASSWORD=your_password

# -------------------------------------------
# OCR Configuration
# -------------------------------------------
OCR_TIMEOUT=1800
OCR_STALL_TIMEOUT=300
OCR_HARD_TIMEOUT=21600
OCR_QUEUE_LOG_INTERVAL=30
OCR_PDF_DPI=200
OCR_PDF_DPI_RETRY=250
OCR_DOWNLOAD_PROGRESS_MB=5

# OCR Mode: "local" (PaddleOCR, default) atau "api" (LLM via Router API)
OCR_MODE=local

# -------------------------------------------
# Router API Configuration (untuk OCR_MODE=api)
# -------------------------------------------
ROUTER_API_URL=http://localhost:20128/v1/chat/completions
ROUTER_API_KEY=your-router-api-key-here

# LLM OCR Model Settings
OCR_LLM_MODEL=ag/gemini-3-flash
OCR_LLM_MAX_TOKENS=8192
OCR_DELAY=2
OCR_RETRIES=3

# -------------------------------------------
# RAG Configuration
# -------------------------------------------
USE_POST_SUMMARY=false
POST_SUMMARY_TOP_K=2

# -------------------------------------------
# Chunking Configuration
# -------------------------------------------
# Dikalibrasi untuk E5 Large multilingual (batas 512 token)
# Child chunk ~380 est. token → ~330-360 token nyata (aman di bawah 512)
DOC_CHILD_CHUNK_SIZE=380
DOC_PARENT_CHUNK_SIZE=1100
DOC_CHUNK_OVERLAP=70
WEB_CHILD_CHUNK_SIZE=380
WEB_PARENT_CHUNK_SIZE=950
ENABLE_SEMANTIC_MERGE=true
SEMANTIC_MERGE_SIM_THRESHOLD=0.32
RETRIEVAL_CONTEXT_EXPANSION=true

# -------------------------------------------
# Web Scraping Configuration
# -------------------------------------------
SCRAPING_TIMEOUT=30
SCRAPING_MAX_RETRIES=3
SCRAPING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
AUTO_DETECT_MIN_CONTENT=300
PLAYWRIGHT_TIMEOUT=30000

# -------------------------------------------
# Webhook Configuration
# -------------------------------------------
DOCUMENT_CALLBACK_URL=
WEB_CALLBACK_URL=
WEB_MANAJEMEN_API_KEY=
WEBHOOK_RETRY_ATTEMPTS=3
# Pertahankan true. Set false hanya sementara saat sertifikat callback expired.
WEBHOOK_SSL_VERIFY=true

# Backward compatibility only:
# WEB_MANAJEMEN_BASE_URL=
# WEB_MANAJEMEN_CALLBACK_URL=

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# -------------------------------------------
# CORS
# -------------------------------------------
CORS_ORIGINS=*

# -------------------------------------------
# Internal API Key (keamanan antar service)
# WAJIB diisi. Semua request ke orchestrator dan service internal
# harus membawa header: X-API-Key: <nilai ini>
# Payload API tidak berubah. Jika kosong, semua request ditolak (fail-closed).
# -------------------------------------------
INTERNAL_API_KEY=change_me_strong_random_secret

# ===========================================
# LIGHTRAG ADAPTER (v4) — LightRAG Integration
# ===========================================

# -------------------------------------------
# Search Engine Selection
# legacy  = existing parallel fan-out (default, production-safe)
# lightrag= LightRAG sebagai primary retrieval engine
# shadow  = legacy ke user, lightrag untuk evaluasi (benchmarking)
# -------------------------------------------
RAG_SEARCH_ENGINE=legacy

# -------------------------------------------
# LightRAG Adapter Service
# -------------------------------------------
LIGHTRAG_ADAPTER_URL=http://localhost:5015
LIGHTRAG_ADAPTER_PORT=5015

# -------------------------------------------
# LightRAG Server Connection
# LightRAG Server harus di-setup terpisah (clone dari GitHub HKUDS/LightRAG)
# Port default: 9621
# -------------------------------------------
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=your-lightrag-api-key-here
LIGHTRAG_WORKSPACE=medan-main

# -------------------------------------------
# LightRAG Query Configuration
# Mode: naive|local|global|hybrid|mix
# mix = menggabungkan local + global + naive (recommended)
# -------------------------------------------
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_TOP_K=10
LIGHTRAG_RERANK_ENABLED=false
LIGHTRAG_INDEX_TIMEOUT_SEC=600
LIGHTRAG_INDEX_POLL_INTERVAL_SEC=2

# -------------------------------------------
# LightRAG Feature Flags
# -------------------------------------------
LIGHTRAG_FALLBACK_TO_LEGACY=true
LIGHTRAG_INDEX_TEXT=true
LIGHTRAG_INDEX_DOCUMENT=true
LIGHTRAG_INDEX_WEB=true
LIGHTRAG_TIMEOUT_SEC=120
LIGHTRAG_MAX_RETRIES=3
